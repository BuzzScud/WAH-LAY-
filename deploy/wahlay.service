; Wah Lay ordering site — Astro SSR (Node standalone adapter).
;
; Bound to loopback ONLY. The site is reached through the Equity Orbit Node API,
; which proxies /api/wahlay/* here (see backend/api/routes/wahlayProxy.js in the
; MAIN2026 repo). Nothing should ever publish this port.
;
; Install:
;   sudo cp deploy/wahlay.service /etc/systemd/system/wahlay.service
;   sudo systemctl daemon-reload
;   sudo systemctl enable --now wahlay
;
; NOTE: `base` and `security.allowedDomains` are baked in at BUILD time, so
; WAHLAY_ALLOWED_HOSTS must be set for `npm run build` — setting it here only
; affects the already-built server and will not change either one.

[Unit]
Description=Wah Lay ordering site (Astro SSR, 127.0.0.1:3000)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/wahlay
EnvironmentFile=/var/www/wahlay/.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
ExecStart=/usr/bin/node ./dist/server/entry.mjs
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15

; The app only ever reads its own tree and talks to Postgres on loopback.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/wahlay

[Install]
WantedBy=multi-user.target
