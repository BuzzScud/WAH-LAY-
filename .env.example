# --- Database ---
DATABASE_URL=postgres://takeout:takeout@localhost:5432/takeout

# --- Site ---
PUBLIC_SITE_NAME="Wah Lay"
PUBLIC_SITE_URL=http://localhost:3000

# --- Auth ---
# Owner login is seeded from these on `npm run db:seed` (change immediately).
ADMIN_USERNAME=owner
ADMIN_PASSWORD=change-me-now
# Long random string; the kitchen tablet visits /kitchen?token=<KITCHEN_TOKEN> once
# to receive its device cookie. Rotate it to log all kitchen devices out.
KITCHEN_TOKEN=generate-a-long-random-string
SESSION_SECRET=generate-another-long-random-string

# Only trust the CF-Connecting-IP header for rate limiting once the origin is
# firewalled to Cloudflare IPs — otherwise it is client-spoofable.
TRUST_CF_HEADER=false

# --- Notifications ---
# console = log only (default, safe for dev). live = real Twilio + Resend sends.
NOTIFY_MODE=console
OWNER_PHONE=+15555550100
# Second number for the 6-minute escalation step (can be a manager)
ESCALATION_PHONE=+15555550101
KITCHEN_EMAIL=orders@example.com

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RESEND_API_KEY=
RESEND_FROM="Orders <orders@yourdomain.com>"

# Phase-2 flag: also SMS the customer when their order is marked Ready
SMS_READY_ENABLED=false
