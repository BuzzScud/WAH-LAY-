---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/inter';
import '@/styles/global.css';
import { db } from '@/db/client';
import { getOpenState } from '@/lib/hours';
import { groupedWeek, todayIndex } from '@/lib/hoursDisplay';
import { DishArtSprite } from '@/components/DishArt';

interface Props {
  title: string;
  description?: string;
  /** Hero pages let the header start transparent and fade in on scroll. */
  transparentHeader?: boolean;
}
const { title, description = 'Order pickup online.', transparentHeader = false } = Astro.props;
const settings = await db.query.storeSettings.findFirst();
const open = await getOpenState();
const hours = await db.query.businessHours.findMany();
const storeName = settings?.name ?? 'Our Restaurant';
const phone = settings?.phone ?? '';
const address = settings?.address ?? '';
const telHref = `tel:${phone.replace(/[^\d+]/g, '')}`;
const mapHref = `https://maps.google.com/?q=${encodeURIComponent(address)}`;
const year = new Date().getFullYear();
const week = groupedWeek(hours, todayIndex(settings?.timezone ?? 'America/New_York'));
const payments = ['Cash', 'Visa', 'MasterCard', 'Discover', 'Apple Pay', 'Zelle', 'Cash App'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#150e0d" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="restaurant.restaurant" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Set before paint so reveal-on-scroll never flashes hidden content
         on a browser where the script is blocked. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="min-h-screen bg-cream text-ink antialiased flex flex-col">
    <DishArtSprite />
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-ink focus:px-4 focus:py-3 focus:text-cream"
      >Skip to content</a
    >

    <header
      id="site-header"
      data-transparent={transparentHeader ? 'true' : null}
      class:list={[
        'fixed inset-x-0 top-0 z-40 transition-[background-color,box-shadow,backdrop-filter] duration-500',
        transparentHeader
          ? 'bg-ink/0 data-[scrolled]:bg-ink/85 data-[scrolled]:backdrop-blur-xl data-[scrolled]:shadow-[0_1px_0_0_rgba(226,180,85,0.18)]'
          : 'bg-ink/90 backdrop-blur-xl shadow-[0_1px_0_0_rgba(226,180,85,0.18)]',
      ]}
    >
      <nav class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-3 sm:gap-5">
        <a href="/" class="group flex items-center gap-2.5" aria-label={`${storeName} home`}>
          <span
            class="relative grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-gradient-to-br from-brand to-brand-dark ring-1 ring-gold/40"
          >
            <span lang="zh" aria-hidden="true" class="text-lg font-semibold leading-none text-gold">華</span>
          </span>
          <span class="flex flex-col leading-none">
            <span class="font-display text-lg font-bold tracking-tight text-cream">{storeName}</span>
            <span class="mt-0.5 text-[10px] uppercase tracking-[0.22em] text-gold/80">Chinese Takeout</span>
          </span>
        </a>

        <div class="ml-auto flex items-center gap-2 sm:gap-4">
          <span
            class="hidden items-center gap-2 rounded-full border border-white/12 bg-white/6 px-3 py-1.5 text-xs font-medium text-cream/85 md:inline-flex"
            role="status"
          >
            <span
              class:list={[
                'h-2 w-2 rounded-full',
                open.isOpen ? 'bg-jade live-dot' : 'bg-white/40',
              ]}
              aria-hidden="true"></span>
            {open.isOpen ? 'Open now' : 'Closed'}
          </span>
          <a
            href={telHref}
            class="hidden min-h-11 items-center text-sm font-medium text-cream/85 underline-offset-4 hover:text-gold hover:underline sm:inline-flex"
            >{phone}</a
          >
          <a
            href="/order"
            class="inline-flex min-h-11 items-center rounded-xl bg-gradient-to-b from-gold to-gold-deep px-5 py-2.5 text-sm font-bold text-ink shadow-lg shadow-black/25 transition-transform duration-300 hover:-translate-y-0.5"
            >Order Now</a
          >
        </div>
      </nav>
    </header>

    <main id="main" class="flex-1 pt-16">
      <slot />
    </main>

    <!-- Hours, phone, address as real text in the footer of every page (§8.4) -->
    <footer class="relative overflow-hidden border-t border-gold/20 bg-ink text-cream/65 grain">
      <div
        class="pointer-events-none absolute inset-x-0 top-0 h-56 bg-[radial-gradient(55%_100%_at_50%_0%,rgba(226,180,85,0.14),transparent)]"
      >
      </div>

      <div class="relative mx-auto max-w-6xl px-4 py-14">
        <div class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-12">
          <!-- Identity -->
          <div class="sm:col-span-2 lg:col-span-4">
            <a href="/" class="inline-flex items-center gap-2.5">
              <span
                class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-gradient-to-br from-brand to-brand-dark ring-1 ring-gold/40"
              >
                <span lang="zh" aria-hidden="true" class="text-lg font-semibold leading-none text-gold">華</span>
              </span>
              <span class="font-display text-xl font-bold text-cream">{storeName}</span>
            </a>
            <p class="mt-4 max-w-xs text-sm leading-relaxed">
              Wok-fired Chinese takeout in Miramar. Build your order online, call it in, pay at the counter.
            </p>
            <a
              href="/order"
              class="mt-5 inline-flex min-h-11 items-center rounded-xl bg-gradient-to-b from-gold to-gold-deep px-5 text-sm font-bold text-ink transition-transform duration-300 hover:-translate-y-0.5"
              >Start an order</a
            >
          </div>

          <!-- Hours -->
          <div class="lg:col-span-4">
            <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">Hours</h2>
            <dl class="mt-4 space-y-1.5 text-sm">
              {
                week.map((g) => (
                  <div
                    class:list={[
                      'flex items-baseline justify-between gap-4 border-b border-white/8 pb-1.5',
                      g.includesToday && 'text-cream',
                    ]}
                  >
                    <dt class:list={['whitespace-nowrap', g.includesToday && 'font-semibold']}>
                      {g.days}
                      {g.includesToday && (
                        <span class="ml-2 rounded bg-gold px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-ink">
                          Today
                        </span>
                      )}
                    </dt>
                    <dd class:list={['whitespace-nowrap tabular-nums', g.includesToday && 'font-semibold']}>
                      {g.hours}
                    </dd>
                  </div>
                ))
              }
            </dl>
          </div>

          <!-- Find us -->
          <div class="lg:col-span-4">
            <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">Where to find us</h2>
            <address class="mt-4 space-y-3 text-sm not-italic leading-relaxed">
              <p class="text-cream">{address}<br /><span class="text-cream/60">Across from Publix</span></p>
              <p>
                <a href={telHref} class="font-display text-lg font-semibold text-cream hover:text-gold">{phone}</a>
              </p>
              <p>Pickup only — no delivery.</p>
            </address>
            <a
              href={mapHref}
              target="_blank"
              rel="noopener"
              class="mt-4 inline-flex min-h-11 items-center rounded-xl border border-white/20 px-5 text-sm font-semibold text-cream transition-colors hover:border-gold/60 hover:bg-white/5"
              >Get directions →</a
            >
          </div>
        </div>

        <!-- Payments -->
        <div class="mt-12 border-t border-white/8 pt-7">
          <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">Pay at pickup</h2>
          <ul class="mt-3 flex flex-wrap gap-2 text-xs">
            {
              payments.map((m) => (
                <li class="rounded-lg border border-white/12 bg-white/5 px-2.5 py-1.5">{m}</li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="relative border-t border-white/8">
        <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-5 text-xs">
          <p>© {year} {storeName}. All rights reserved.</p>
          <a href="/privacy" class="underline underline-offset-4 hover:text-gold">Privacy policy</a>
        </div>
      </div>
    </footer>

    <script is:inline>
      // Header background on scroll + reveal-on-scroll. Both are progressive
      // enhancement: without this file the page is fully readable.
      (function () {
        var header = document.getElementById('site-header');
        if (header && header.dataset.transparent) {
          var onScroll = function () {
            if (window.scrollY > 24) header.setAttribute('data-scrolled', '');
            else header.removeAttribute('data-scrolled');
          };
          onScroll();
          window.addEventListener('scroll', onScroll, { passive: true });
        }

        var targets = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          targets.forEach(function (el) {
            el.classList.add('in');
          });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.06 }
        );
        targets.forEach(function (el) {
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>
